# Build output.
# NOTE the leading slash: an unanchored "build/" also matches
# third_party/minhook/build/, which is where MinHook's MinGW makefile lives --
# the one file the whole build depends on. Without the slash a fresh clone fails
# with "No rule to make target 'build/MinGW/Makefile'".
/build/
dist/*.dll
dist/*.asi
dist/*.a
*.o
*.d
*.res
*.lib
*.exp

# MinHook in-tree build artifacts (we build it from its own MinGW makefile)
third_party/minhook/src/**/*.o
third_party/minhook/src/**/*.d
third_party/minhook/build/MinGW/*.a
third_party/minhook/build/MinGW/*.dll

# Experiment binaries (sources and RESULTS.md are tracked, outputs are not)
experiments/**/*.exe
experiments/**/*.dll
experiments/**/*.a
experiments/**/*.o
experiments/**/*.log
experiments/**/out/
experiments/**/out-static/
experiments/**/out-shared/
experiments/**/out-noeh/

# NOTE: third_party/openvr/{headers,bin/win32} ARE tracked on purpose.
# openvr_api.dll (win32) is ~620K and the experiments are worthless without the
# exact binary they were run against.

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local, machine-specific toolchain overrides
local.mk

# Regenerable analysis caches from research/engine tooling
research/engine/*.pkl
research/engine/__pycache__/
